<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         prefWidth="370.0"
         spacing="8.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <!-- A fixed-width font keeps the [T][X] markers in a task list lined up.
         minHeight of -Infinity lets the label grow downwards instead of clipping. -->
    <Label fx:id="dialog"
           text="Label"
           wrapText="true"
           minHeight="-Infinity"
           maxWidth="240.0"
           style="-fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 12px;" />
    <ImageView fx:id="displayPicture"
               fitHeight="52.0"
               fitWidth="52.0"
               pickOnBounds="true"
               preserveRatio="true" />
  </children>
  <padding>
    <Insets bottom="10.0" left="8.0" right="8.0" top="10.0" />
  </padding>
</fx:root>
